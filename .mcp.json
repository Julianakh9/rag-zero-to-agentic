{
  "mcpServers": {
    "rag-lab": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "lab/mcp_server.py"
      ],
      "env": {
        "RAG_ROLE": "employee",
        "RAG_CORPUS": "company"
      }
    },
    "cv-desk": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "lab/mcp_server.py"
      ],
      "env": {
        "RAG_ROLE": "employee",
        "RAG_CORPUS": "cvs"
      }
    },
    "cv-chatbot": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "challenge/mcp_server.py"
      ],
      "env": {
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "CV_DIR": "data/cvs/candidates"
      }
    }
  }
}
